{
  "functions": [{"source":"functions", "codebase":"ekip", "runtime":"nodejs22", "predeploy":["node scripts/sync-shared.mjs"]}],
  "firestore": {"rules":"firebase/firestore.rules", "indexes":"firebase/firestore.indexes.json"},
